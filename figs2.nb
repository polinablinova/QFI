                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}]}], 
                    " ", "t"}], "]"}], ".", "y"}]}], ",", 
                 RowBox[{"-", 
                  RowBox[{"x", ".", 
                   RowBox[{"MatrixExp", "[", 
