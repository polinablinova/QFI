Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"i", ",", "j", ",", "t", ",", "\[Delta]", ",", "\[Sigma]"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Nmodes", "=", "5"}], ";", 
   RowBox[{"i", "=", "5"}], ";", 
   RowBox[{"t", "=", "1"}], ";", 
   RowBox[{"\[Delta]", "=", "1"}], ";", 
   RowBox[{"\[Sigma]", "=", "7"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"i", ",", "j", ",", "m", ",", "k"}], "]"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"t", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Lambda]", "[", "m", "]"}], "+", 
             RowBox[{"\[Lambda]", "[", "k", "]"}]}], ")"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "Nmodes"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "Nmodes"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"ListLinePlot", "[", " ", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["Nmodes", "2"], " "}], "4"], 
       RowBox[{"Table", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"BesselI", "[", 
             RowBox[{
              RowBox[{"i", "-", "j"}], ",", 
              RowBox[{"2", " ", "t", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"\[Delta]", " ", "\[Sigma]"}], "]"}]}]}], "]"}], "-", 
            RowBox[{"BesselI", "[", 
             RowBox[{
              RowBox[{"i", "+", "j"}], ",", 
