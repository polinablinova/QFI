       RowBox[{"k", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Assuming", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"g", ",", "\[Chi]"}], "}"}], "\[Element]", "Reals"}], "&&", 
