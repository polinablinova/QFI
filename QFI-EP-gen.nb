         "Simplify"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"h", ",", "1", ",", "Nmodes"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}], "//", 
