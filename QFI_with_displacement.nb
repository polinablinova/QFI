      RowBox[{"Scovar", ".", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
       RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
