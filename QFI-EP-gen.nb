Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"non", "-", 
    RowBox[{"zero", " ", "EP"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"g", ",", "\[Chi]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Omega]1"}], ",", "g", ",", "\[Xi]1", ",",
          "\[Chi]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "g"}], ",", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Omega]2"}], ",", "\[Chi]", ",", 
         "\[Xi]2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Xi]1", ",", "\[Chi]", ",", 
         RowBox[{"I", " ", "\[Omega]1"}], ",", "g"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Chi]", ",", "\[Xi]2", ",", 
         RowBox[{"-", "g"}], ",", 
         RowBox[{"I", " ", "\[Omega]2"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "//", "TraditionalForm"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOMEP", "=", 
     RowBox[{"EOM", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Xi]2", "->", "0"}], ",", 
        RowBox[{"\[Omega]2", "->", "0"}], ",", 
        RowBox[{"\[Omega]1", "->", "0"}], ",", 
        RowBox[{"\[Xi]1", "->", 
         RowBox[{"2", " ", "g"}]}], ",", 
        RowBox[{"\[Chi]", "->", "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"EOMEP", "//", "Eigensystem"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DM", "=", 
    RowBox[{
     RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
     RowBox[{"(", "EOMEP", ")"}], ".", 
     RowBox[{"ConjugateTranspose", "[", 
      RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"S", "=", 
    RowBox[{
     RowBox[{"MatrixExp", "[", 
      RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Scovar", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", 
       RowBox[{"Transpose", "[", 
        RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"Scovar", ".", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
       RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]out", "=", 
     RowBox[{
      RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
       RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", "=", 
     RowBox[{"Sphase", ".", "Scovar", ".", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<x\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<p\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "Nmodes"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"FcovEP", ",", "FdispEP", ",", "n2EP"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["1", "4"], " ", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
            RowBox[{"D", "[", 
             RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
            RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
            RowBox[{"D", "[", 
             RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "/.", 
           RowBox[{"\[Phi]", "->", "0"}]}], "]"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Lambda]", ",", "\[Phi]"}], "]"}], ".", 
           RowBox[{"Inverse", "[", 
            RowBox[{"\[CapitalSigma]out", "/.", 
             RowBox[{"\[Phi]", "->", "0"}]}], "]"}], ".", 
           RowBox[{"D", "[", 
            RowBox[{"\[Lambda]", ",", "\[Phi]"}], "]"}]}]}], "/.", 
         RowBox[{"\[Phi]", "->", "0"}]}], "//", "FullSimplify"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Tr", "[", "\[CapitalSigma]out", "]"}], "-", 
            RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "+", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{
           RowBox[{"Transpose", "[", "\[Lambda]", "]"}], ".", 
           "\[Lambda]"}]}]}], "//", "FullSimplify"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"FcovEP", "+", "FdispEP"}], "n2EP"], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "->", "0"}], ",", 
       RowBox[{"x2", "->", "0"}], ",", 
       RowBox[{"p1", "->", "0"}], ",", 
       RowBox[{"p2", "->", "0"}]}], "}"}]}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]"}]}]], "Input",
