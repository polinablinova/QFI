Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "PARAMETERS", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"nMax", "=", "200"}], ";"}], "          ", 
   RowBox[{"(*", 
    RowBox[{"Fock", " ", "cutoff"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"r", "=", "1"}], ";"}], "         ", 
   RowBox[{"(*", 
    RowBox[{"squeezing", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"BASIS", ":", 
     RowBox[{
      RowBox[{"Fock", " ", "states"}], "|", 
      RowBox[{"n", ">"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"basis", "=", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"nMax", "+", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Annihilation", " ", "and", " ", "creation", " ", "operators"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", "==", 
           RowBox[{"n", "-", "1"}]}], ",", 
          RowBox[{"Sqrt", "[", "n", "]"}], ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", "nMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "0", ",", "nMax"}], "}"}]}], "]"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"adag", "=", 
     RowBox[{"Transpose", "[", "a", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Quadratures", "*)"}], "\n", 
   RowBox[{
    RowBox[{"X", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", "adag"}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "-", "adag"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"I", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Quadratic", " ", "generators", " ", 
     RowBox[{"(", "example", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"K1", "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"X", ".", "X"}], "-", 
        RowBox[{"P", ".", "P"}]}], ")"}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"squeezing", " ", "along", " ", "X"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"K2", "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"X", ".", "P"}], "+", 
        RowBox[{"P", ".", "X"}]}], ")"}]}]}], ";"}], "       ", 
   RowBox[{"(*", 
    RowBox[{"45", "-", 
     RowBox[{"degree", " ", "squeezing"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Glist", "=", 
     RowBox[{"{", 
      RowBox[{"X", ",", "P", ",", "K1", ",", "K2"}], "}"}]}], ";"}], 
   "         ", 
   RowBox[{"(*", 
    RowBox[{"choose", " ", "your", " ", "basis"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Single", "-", 
       RowBox[{"mode", " ", "squeezed", " ", "vacuum"}]}], "|", 
      RowBox[{"psi", ">"}]}], " ", "=", 
     RowBox[{
      RowBox[{"S", 
       RowBox[{"(", "r", ")"}]}], "|", 
      RowBox[{"0", ">"}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Squeezing", " ", "operator", " ", "S", 
       RowBox[{"(", "r", ")"}], " ", "in", " ", "Fock", " ", 
       RowBox[{"basis", ":", 
        RowBox[{"use", " ", "standard", " ", "series"}]}]}], ";", "here"}], ",", 
     RowBox[{
      RowBox[{"directly", " ", "from", " ", "definition", " ", "on"}], "|", 
      RowBox[{"0", ">"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"squeezedVacuum", "[", 
      RowBox[{"r_", ",", "nmax_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"psi", ",", "norm", ",", "k"}], "}"}], ",", 
       RowBox[{
        RowBox[{"psi", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"nmax", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"norm", "=", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Cosh", "[", "r", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", "=", "0"}], ",", 
          RowBox[{"k", "<=", 
           RowBox[{"Floor", "[", 
            RowBox[{"nmax", "/", "2"}], "]"}]}], ",", 
          RowBox[{"k", "++"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", " ", "k"}], "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{"norm", "*", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", 
                 RowBox[{"Tanh", "[", "r", "]"}]}], ")"}], "^", "k"}], ")"}], 
             "*", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"Factorial", "[", 
                RowBox[{"2", " ", "k"}], "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "^", "k"}], " ", 
                RowBox[{"Factorial", "[", "k", "]"}]}], ")"}]}]}]}], ";"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"psi", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"psi", ".", 
           RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"psi", "=", 
     RowBox[{"squeezedVacuum", "[", 
      RowBox[{"r", ",", "nMax"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "psi", ",", 
       RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"|", 
     RowBox[{"psi", ">", "<", "psi"}], "|"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"EXPECTATION", " ", "VALUES"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"expect", "[", 
      RowBox[{"rho_", ",", "A_"}], "]"}], ":=", 
     RowBox[{"Tr", "[", 
      RowBox[{"rho", ".", "A"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"QFIM", " ", "via", " ", "Reilly", " ", "et", " ", 
       RowBox[{"al", ".", "Eq", ".", 
        RowBox[{"(", "4", ")"}]}]}], ":", 
      RowBox[{"F_", 
       RowBox[{"{", "\[Mu]\[Nu]", "}"}]}]}], "=", 
     RowBox[{
      RowBox[{"2", "<", 
       RowBox[{"{", 
        RowBox[{"G_\[Mu]", ",", "G_\[Nu]"}], "}"}], ">", 
       RowBox[{"-", "4"}], "<", "G_\[Mu]", ">", "<", "G_\[Nu]", ">"}], " ", "=", 
      RowBox[{"4", " ", "Cov", 
       RowBox[{"(", 
        RowBox[{"G_\[Mu]", ",", "G_\[Nu]"}], ")"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"qfim", "[", 
      RowBox[{"rho_", ",", "Gs_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"m", "=", 
          RowBox[{"Length", "[", "Gs", "]"}]}], ",", "F", ",", "mu", ",", 
         "nu", ",", "Gmu", ",", "Gnu", ",", "anticomm", ",", "eAC", ",", 
         "eMu", ",", "eNu"}], "}"}], ",", 
       RowBox[{
        RowBox[{"F", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "m"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"mu", "=", "1"}], ",", 
          RowBox[{"mu", "<=", "m"}], ",", 
          RowBox[{"mu", "++"}], ",", 
          RowBox[{
           RowBox[{"Gmu", "=", 
            RowBox[{"Gs", "[", 
             RowBox[{"[", "mu", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"eMu", "=", 
            RowBox[{"Chop", "[", 
             RowBox[{"expect", "[", 
              RowBox[{"rho", ",", "Gmu"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"nu", "=", "1"}], ",", 
             RowBox[{"nu", "<=", "m"}], ",", 
             RowBox[{"nu", "++"}], ",", 
             RowBox[{
              RowBox[{"Gnu", "=", 
               RowBox[{"Gs", "[", 
                RowBox[{"[", "nu", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eNu", "=", 
               RowBox[{"Chop", "[", 
                RowBox[{"expect", "[", 
                 RowBox[{"rho", ",", "Gnu"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"anticomm", "=", 
               RowBox[{
                RowBox[{"Gmu", ".", "Gnu"}], "+", 
                RowBox[{"Gnu", ".", "Gmu"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"eAC", "=", 
               RowBox[{
                RowBox[{"Chop", "[", 
                 RowBox[{"expect", "[", 
                  RowBox[{"rho", ",", "anticomm"}], "]"}], "]"}], "/", 
                "2"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"F", "[", 
                RowBox[{"[", 
                 RowBox[{"mu", ",", "nu"}], "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{"2", " ", "eAC"}], "-", 
                RowBox[{"4", " ", "eMu", " ", "eNu"}]}]}], ";"}]}], "]"}], 
           ";"}]}], "]"}], ";", "\[IndentingNewLine]", "F"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{
      RowBox[{"qfim", "[", 
       RowBox[{"rho", ",", "Glist"}], "]"}], "//", "N"}]}], ";"}], "\n", 
   RowBox[{"F", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Diagonalize", " ", "to", " ", "get", " ", "optimal", " ", "generator", " ",
      "coefficients"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"valsVecs", "=", 
     RowBox[{"Eigensystem", "[", "F", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lambdaMax", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"valsVecs", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"optVec", "=", 
     RowBox[{"valsVecs", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", 
        RowBox[{"First", "@", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"valsVecs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "lambdaMax", "\[IndentingNewLine]", "optVec", 
   "\[IndentingNewLine]", "\n", "\n"}]}]], "Input",
 CellChangeTimes->{{3.9792070548811684`*^9, 3.9792070548811684`*^9}, 
   3.9792071266913204`*^9, {3.9792071623972473`*^9, 3.9792071625546265`*^9}, {
