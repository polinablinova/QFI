         RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}], 
       RowBox[{"1", "+", "\[Mu]sq"}]]}], "//", "FullSimplify"}]}], 
