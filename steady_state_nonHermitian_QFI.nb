                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}], " ",
                     "t"}], "]"}], ".", 
                    RowBox[{"Transpose", "[", "x", "]"}]}]}], "}"}]}], 
                "]"}]}], "]"}]}], "]"}]}], "-", 
          FractionBox["Nmodes", "2"]}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Fcov", "=", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"-", "1"}], "2"], " ", "tr"}], "-", "Nmodes"}]}], ";", 
       "\[IndentingNewLine]", 
       FractionBox["Fcov", "nout"]}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
