Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{"BQH", "[", 
       RowBox[{"Nmodes", ",", 
        RowBox[{"{", "}"}]}], "]"}], "/.", 
      RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
       RowBox[{"(", "EOM", ")"}], ".", 
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}], "//", "FullSimplify"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM is\>\"", "\[IndentingNewLine]", 
   RowBox[{"DMep", "=", 
    RowBox[{
     RowBox[{"DM", "/.", 
      RowBox[{
       SubscriptBox["\[Xi]", "1"], "->", 
       SubscriptBox["\[Omega]", "1"]}]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"SEP", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{"DMep", " ", "t"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}], "//", 
      "FullSimplify"}], "//", "Expand"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"der", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"DM", ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DMep", " ", "t"}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}]}], "+", 
      RowBox[{"t", " ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DMep", " ", "t"}], "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DM", "]"}], ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}]}]}], "//",
      "FullSimplify"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der", ".", 
     RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der"}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", "\"\<QFI EP\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fwep", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der", ".", 
        RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der"}], "]"}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"nep", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "SEP", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", 
     "FullSimplify"}]}]}]}]], "Input",
