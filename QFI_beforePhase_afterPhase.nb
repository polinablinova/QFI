Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"g", ",", "\[Chi]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmodes", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[Omega]1"}], ",", "g", ",", "\[Xi]1", ",",
         "\[Chi]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "g"}], ",", 
        RowBox[{
         RowBox[{"-", "I"}], " ", "\[Omega]2"}], ",", "\[Chi]", ",", 
        "\[Xi]2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Xi]1", ",", "\[Chi]", ",", 
        RowBox[{"I", " ", "\[Omega]1"}], ",", "g"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Chi]", ",", "\[Xi]2", ",", 
        RowBox[{"-", "g"}], ",", 
        RowBox[{"I", " ", "\[Omega]2"}]}], "}"}]}], "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Xi]2", "->", "0"}], ",", 
      RowBox[{"\[Omega]2", "->", "0"}], ",", 
      RowBox[{"\[Omega]1", "->", "0"}], ",", 
      RowBox[{"\[Xi]1", "->", 
       RowBox[{"2", " ", "g"}]}], ",", 
      RowBox[{"\[Chi]", "->", "0"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DM", "=", 
   RowBox[{
    RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
    RowBox[{"(", "EOM", ")"}], ".", 
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Scovar", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]in", "=", 
   RowBox[{
    RowBox[{"Scovar", ".", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
     RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Sphase", ".", "Scovar", ".", 
    RowBox[{"Flatten", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<x\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<p\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "Nmodes"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"FcovEP", ",", "nEP"}], "}"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", "g"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", "g"}], "]"}]}], "]"}]}], "//", 
     "FullSimplify"}], ",", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify"}]}], 
   "}"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.978381441807398*^9, 
  3.978381509845598*^9}},ExpressionUUID->"7733dc0e-5188-d040-9449-\
964bd7457926"],

