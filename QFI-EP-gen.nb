Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "TRY", " ", "TO", " ", "UNDERSTAND", " ", "HOW", " ", "QFI", " ", "SCALES", 
   " ", "WITH", " ", "N", " ", "FOR", " ", "A", " ", "BKC", " ", "NOT", " ", 
   "AT", " ", "AN", " ", "EP"}], "*)"}]], "Input",
 CellChangeTimes->{{3.978432869442047*^9, 
  3.9784328858889065`*^9}},ExpressionUUID->"e60e6a18-c325-ad4c-880d-\
2a0df3865ff9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "analytical", " ", "calculations", " ", "NOT", " ", "at", " ", "an", " ", 
    "EP"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"g", ",", "\[Chi]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Nmodes", "=", "4"}], ";", "\[IndentingNewLine]", 
     RowBox[{"EOM", "=", 
      RowBox[{"BosonicKitaevChain", "[", 
       RowBox[{"Nmodes", ",", "g", ",", 
        RowBox[{"\[Phi]b", "=", "0"}], ",", "\[Chi]", ",", 
        RowBox[{"\[Phi]\[Chi]", "=", "0"}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"DM", "=", 
      RowBox[{
       RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
       RowBox[{"(", "EOM", ")"}], ".", 
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eigs", "=", 
      RowBox[{
       RowBox[{"Eigensystem", "[", "DM", "]"}], "\[IndentingNewLine]", 
       RowBox[{"S", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"eigs", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"eigs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "]"}], " ", "t"}], "]"}], ".", 
         RowBox[{"Inverse", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"eigs", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TrS", "=", 
      RowBox[{
       RowBox[{"Inverse", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"eigs", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "]"}], " ", "t"}], "]"}], ".", 
       RowBox[{"eigs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"InS", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"eigs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "]"}]}], " ", "t"}], "]"}], ".", 
       RowBox[{"Inverse", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"eigs", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"InTrS", "=", 
      RowBox[{
       RowBox[{"Inverse", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"eigs", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "]"}]}], " ", "t"}], "]"}], ".", 
       RowBox[{"eigs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalSigma]in", "=", 
      RowBox[{
       RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", "TrS", ".", 
       RowBox[{"Transpose", "[", 
        RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[CapitalSigma]in", "//", "FullSimplify"}], "//", 
      RowBox[{"TraditionalForm", "\[IndentingNewLine]", 
       RowBox[{"In\[CapitalSigma]in", "=", 
        RowBox[{
         RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "InTrS", ".", "InS",
          ".", 
         RowBox[{"Transpose", "[", 
          RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}]}]}]}], ";", 
     "\[IndentingNewLine]", 
