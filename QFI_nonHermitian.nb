         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]in", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]out", "=", 
     RowBox[{
      RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
       RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", "\"\<Purity\>\"", "\[IndentingNewLine]", 
   RowBox[{"\[Mu]sq", "=", 
