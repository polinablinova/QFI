  "In[1639]:=",ExpressionUUID->"d859ec88-3f71-fb41-8082-782c4893933f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"steady", "-", 
    RowBox[{"state", " ", "analytical"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Xi]", "1"], ",", 
        SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
       "Reals"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "\[Kappa]", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BQH", "[", 
        RowBox[{"Nmodes", ",", 
         RowBox[{"{", "}"}]}], "]"}], "-", 
       RowBox[{
        FractionBox["\[Kappa]", "2"], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
      RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\"\<EOM is\>\"", "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "MatrixForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM eigenvalues are\>\"",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "Eigenvalues"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Stability threshold is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Kappa]", "2"]}], "+", 
        SqrtBox[
         RowBox[{
          SubsuperscriptBox["\[Xi]", "1", "2"], "-", 
          SubsuperscriptBox["\[Omega]", "1", "2"]}]]}], "==", "0"}], ",", 
      "\[Kappa]"}], "]"}], "//", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Xi]", "1"], ",", 
           SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
          "Reals"}], ",", "#"}], "]"}], "]"}], "&"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\"\<SS covariance matrix\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"LyapunovSolve", "[", 
       RowBox[{"DM", " ", ",", 
        RowBox[{"Transpose", "[", "DM", "]"}], ",", 
        RowBox[{
         RowBox[{"-", "\[Kappa]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]in", "//", "MatrixForm"}], 
   "\[IndentingNewLine]", "\"\<Wigner\>\"", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " ", "\[Pi]", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}], "]"}]}]], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "1"}], "2"], " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "p"}], "}"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"{", 
          RowBox[{"x", ",", "p"}], "}"}]}]}], "]"}]}], "//", "FullSimplify"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], "2"], " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "p"}], "}"}], ".", 
      RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
      RowBox[{"{", 
       RowBox[{"x", ",", "p"}], "}"}]}]}], "//", "FullSimplify"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}], "]"}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Wigner at thresdhol\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " ", "\[Pi]", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}], "]"}]}]], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "1"}], "2"], " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "p"}], "}"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"{", 
          RowBox[{"x", ",", "p"}], "}"}]}]}], "]"}]}], "/.", 
     RowBox[{"\[Kappa]", "\[Rule]", 
      RowBox[{"2", " ", 
       SqrtBox[
        RowBox[{
         SubsuperscriptBox["\[Xi]", "1", "2"], "-", 
         SubsuperscriptBox["\[Omega]", "1", "2"]}]]}]}]}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]out", "=", 
     RowBox[{
      RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
       RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", "\"\<Purity\>\"", "\[IndentingNewLine]", 
   RowBox[{"\[Mu]sq", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<QFI is\>\"", "\[IndentingNewLine]", 
   RowBox[{"F", "=", 
