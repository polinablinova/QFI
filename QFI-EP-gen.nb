Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "positives", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmodes", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{"BosonicKitaevChain", "[", 
      RowBox[{"Nmodes", ",", "g", ",", 
       RowBox[{"\[Phi]b", "=", "0"}], ",", "\[Chi]", ",", 
       RowBox[{"\[Phi]\[Chi]", "=", "0"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "TraditionalForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<First block\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T1", "=", 
     RowBox[{
      RowBox[{"DM", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"1", ";;", "Nmodes"}], ",", 
         RowBox[{"1", ";;", "Nmodes"}]}], "]"}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T1", "//", "Eigensystem"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T2", "=", 
     RowBox[{
      RowBox[{"DM", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Nmodes", "+", "1"}], ";;", 
          RowBox[{"2", " ", "Nmodes"}]}], ",", 
         RowBox[{
          RowBox[{"Nmodes", "+", "1"}], ";;", 
          RowBox[{"2", " ", "Nmodes"}]}]}], "]"}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T2", "==", 
     RowBox[{"-", 
      RowBox[{"Transpose", "[", "T1", "]"}]}]}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", "\"\<Matrix exponential\>\"", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", "T1", "]"}], ".", 
