Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Add", " ", "correlations"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmodes", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"SPDC", "[", 
        RowBox[{"Nmodes", ",", 
         RowBox[{"{", "}"}]}], "]"}], "/.", 
       RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}], "/.", 
      RowBox[{"SPDCBS2", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
