Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"BQH", "[", 
      RowBox[{"Nmodes", ",", 
       RowBox[{"{", "}"}]}], "]"}], "-", 
     RowBox[{
      FractionBox["\[Kappa]", "2"], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
    RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DM", "=", 
    RowBox[{
     RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
     RowBox[{"(", "EOM", ")"}], ".", 
     RowBox[{"ConjugateTranspose", "[", 
      RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "=", "1"}], ";", 
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=", "1.05"}], ";", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "\[CapitalSigma]in", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"int", "=", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{"DM", " ", 
         RowBox[{"(", 
          RowBox[{"t", "-", "s"}], ")"}]}], "]"}], " ", 
       FractionBox["\[Kappa]", "2"], "  ", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "DM", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"t", "-", "s"}], ")"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"DM", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalSigma]in", "=", 
    RowBox[{
     RowBox[{"S", ".", 
      RowBox[{"Transpose", "[", "S", "]"}]}], "+", "int"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"ArrayFlatten", "@", 
    RowBox[{"ReleaseHold", "@", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Hold", "/@", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", "Nmodes"}], 
        "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sphase", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]out", "=", 
   RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
    RowBox[{"Transpose", "[", "Sphase", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]sq", "=", 
   FractionBox["1", 
    RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "=", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}], 
      RowBox[{"1", "+", "\[Mu]sq"}]]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plt1", "=", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"F", "/.", 
         RowBox[{"\[Phi]", "->", "0"}]}], "]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"no", " ", "loss"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
 RowBox[{
  SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "\[Kappa]", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{
    RowBox[{"BQH", "[", 
     RowBox[{"Nmodes", ",", 
      RowBox[{"{", "}"}]}], "]"}], "/.", 
    RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DM", "=", 
   RowBox[{
    RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
    RowBox[{"(", "EOM", ")"}], ".", 
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{
    RowBox[{"MatrixExp", "[", 
     RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Scovar", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", 
     RowBox[{"Transpose", "[", 
      RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]in", "=", 
   RowBox[{
    RowBox[{"Scovar", ".", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
     RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sphase", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]out", "=", 
   RowBox[{
    RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
     RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]sq", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]], "//", 
    "FullSimplify"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Fnoloss", "=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
      RowBox[{"D", "[", 
       RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
      RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
      RowBox[{"D", "[", 
       RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}]}], "//", 
   "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Xi]", "1"], "=", "1.05"}], ";", 
  RowBox[{
   SubscriptBox["\[Omega]", "1"], "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plt2", "=", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Evaluate", "[", 
        RowBox[{"Fnoloss", "/.", 
         RowBox[{"\[Phi]", "->", "0"}]}], "]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotStyle", "->", "Dashed"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"plt1", ",", "plt2"}], "]"}]}], "Input",
