            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["2", 
                RowBox[{"Nmodes", "+", "1"}]], ")"}], "2"], 
             RowBox[{"ArrayFlatten", "[", 
              RowBox[{"ReleaseHold", "@", 
               RowBox[{"DiagonalMatrix", "[", 
                RowBox[{"Hold", "/@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", ".", 
