Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Xi]1", ",", "\[Omega]1", ",", "\[Kappa]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BQH", "[", 
         RowBox[{"Nmodes", ",", 
          RowBox[{"{", "}"}]}], "]"}], "/.", 
        RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Xi]", "1"], "->", "\[Xi]1"}], ",", 
         RowBox[{
          SubscriptBox["\[Omega]", "1"], "->", "\[Omega]1"}]}], "}"}]}], "/.", 
      RowBox[{"\[Kappa]", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"DM", " ", "t"}], "]"}], ".", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "DM", "]"}], " ", "t"}], "]"}]}], "//", 
     "FullSimplify"}], "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DM", " ", "s"}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DM", "]"}], " ", "s"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}], "//", 
     "FullSimplify"}], "//", "MatrixForm"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]sq", "=", 
     FractionBox["1", 
      RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}]]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fw", "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", "n"}]], " ", 
      FractionBox[
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", "\[Omega]1"}], "]"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", "\[Omega]1"}], "]"}]}], "]"}], 
       RowBox[{"1", "+", "\[Mu]sq"}]]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Xi]1", "=", "\[Omega]1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"DM", " ", "t"}], "]"}], ".", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "DM", "]"}], " ", "t"}], "]"}]}], "//", 
     "FullSimplify"}], "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DM", " ", "s"}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DM", "]"}], " ", "s"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}], "//", 
     "FullSimplify"}], "//", "MatrixForm"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
