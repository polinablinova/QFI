   RowBox[{
    RowBox[{"T2", "=", 
     RowBox[{
      RowBox[{"DM", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"Nmodes", "+", "1"}], ";;", 
