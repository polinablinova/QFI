Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Omega]", "1"], "\[Rule]", 
     TemplateBox[{
       RowBox[{
         RowBox[{"-", 
           FractionBox["1", "2"]}], " ", 
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             RowBox[{"Im", "[", "\[Kappa]", "]"}], "2"], "+", 
            RowBox[{"4", " ", 
              SubsuperscriptBox["\[Xi]", "1", "2"]}]}]]}], 
       RowBox[{
         RowBox[{
           RowBox[{"Re", "[", "\[Kappa]", "]"}], "\[Equal]", "0"}], "&&", 
         RowBox[{
           RowBox[{"Im", "[", "\[Kappa]", "]"}], "\[GreaterEqual]", "0"}]}]},
      "ConditionalExpression"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Omega]", "1"], "\[Rule]", 
     TemplateBox[{
       RowBox[{
         FractionBox["1", "2"], " ", 
