Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"YOU", " ", 
     RowBox[{"CAN", "'"}], "T", " ", "DO", " ", "THIS"}], ",", " ", 
    RowBox[{"IT", " ", "MESSES", " ", "UP", " ", "THE", " ", "DERIVATIVE"}]}],
    " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"DMEP", "=", 
    RowBox[{"DM", " ", "/.", 
     RowBox[{
      SubscriptBox["\[Xi]", "1"], "->", 
      SubscriptBox["\[Omega]", "1"]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]EP", "=", 
    RowBox[{"LyapunovSolve", "[", 
     RowBox[{"DMEP", ",", 
      RowBox[{"Transpose", "[", "DMEP", "]"}], ",", 
      RowBox[{
       RowBox[{"-", "\[Kappa]"}], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Is solving the Lyapunov equation assuming EP \
before and after give the same result\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalSigma]EP", "==", "\[CapitalSigma]in"}], "/.", 
     RowBox[{
      SubscriptBox["\[Xi]", "1"], "->", 
      SubscriptBox["\[Omega]", "1"]}]}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", "\"\<Yes, so we have to be differentiating original \
