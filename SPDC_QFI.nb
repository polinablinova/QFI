Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Put", " ", "it", " ", "at", " ", "an", " ", "EP"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmodes", "=", "6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"SPDC", "[", 
         RowBox[{"Nmodes", ",", 
          RowBox[{"{", "}"}]}], "]"}], "/.", 
        RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}], "/.", 
       RowBox[{"killSPDCBS", "[", "Nmodes", "]"}]}], "/.", 
      RowBox[{"g", "->", "\[Chi]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "//", "TraditionalForm"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Scovar", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", 
       RowBox[{"Transpose", "[", 
        RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"Scovar", ".", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
       RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", "\"\<Covariance matrix is\>\"", "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]in", "//", "TraditionalForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]out", "=", 
     RowBox[{
      RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
       RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]", "=", 
     RowBox[{"Sphase", ".", "Scovar", ".", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<x\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<p\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "Nmodes"}], "}"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"F", ",", "n"}], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"-", 
