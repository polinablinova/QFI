         RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], ";", 
      "\[IndentingNewLine]", 
