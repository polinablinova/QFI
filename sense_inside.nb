  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "EP", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"BQH", "[", 
       RowBox[{"Nmodes", ",", 
        RowBox[{"{", "}"}]}], "]"}], "-", 
      RowBox[{
       FractionBox["\[Kappa]", "2"], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
     RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Xi]", "1"], "->", "\[Xi]1"}], ",", 
      RowBox[{
       SubscriptBox["\[Omega]", "1"], "->", "\[Omega]1"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DM", "=", 
   RowBox[{
    RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
    RowBox[{"(", "EOM", ")"}], ".", 
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"int", "=", 
   RowBox[{
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"\[Kappa]", "  ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DM", " ", 
          RowBox[{"(", 
           RowBox[{"t", "-", "s"}], ")"}]}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DM", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"t", "-", "s"}], ")"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"DM", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]in", "=", 
   RowBox[{
    RowBox[{"S", ".", 
     RowBox[{"Transpose", "[", "S", "]"}]}], "+", "int"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", 
       RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]sq", "=", 
    FractionBox["1", 
     RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fx", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "n"}]], " ", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", "\[Xi]1"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", "\[Xi]1"}], "]"}]}], "]"}], 
      RowBox[{"1", "+", "\[Mu]sq"}]]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plt1", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Evaluate", "[", "Fx", "]"}], "/.", 
       RowBox[{"\[Xi]1", "->", "1.1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Red", ",", "Blue"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<EP, \!\(\*SubscriptBox[\(\[Xi]\), \(1\)]\) = \
\!\(\*SubscriptBox[\(\[Omega]\), \(1\)]\) = 1\>\"", 
            ",", "\"\<Above EP, \!\(\*SubscriptBox[\(\[Xi]\), \(1\)]\) = \
1.05, \!\(\*SubscriptBox[\(\[Omega]\), \(1\)]\) = 1\>\""}], "}"}], ",", 
          RowBox[{"LabelStyle", "->", 
           RowBox[{"{", 
            RowBox[{"FontSize", "->", "10"}], "}"}]}], ",", 
          RowBox[{"LegendMargins", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"Spacings", "->", 
           RowBox[{"{", 
            RowBox[{"0.4", ",", "0.3"}], "}"}]}], ",", 
          RowBox[{"LegendFunction", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Framed", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Background", "->", "White"}], ",", 
               RowBox[{"FrameStyle", "->", "Black"}], ",", 
               RowBox[{"FrameMargins", "->", "3"}]}], "]"}], "&"}], ")"}]}]}],
          "\n", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"Right", ",", "Bottom"}], "}"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
