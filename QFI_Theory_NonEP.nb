Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nmodes", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "[", 
    RowBox[{"i_", ",", "j_", ",", "k_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sin", "[", 
     FractionBox[
      RowBox[{"i", " ", "k", " ", "\[Pi]"}], 
      RowBox[{"Nmodes", "+", "1"}]], "]"}], " ", 
    RowBox[{"Sin", "[", 
     FractionBox[
      RowBox[{"j", " ", "k", " ", "\[Pi]"}], 
      RowBox[{"Nmodes", "+", "1"}]], "]"}], " ", 
    RowBox[{"Sin", "[", 
     FractionBox[
      RowBox[{"i", " ", "m", " ", "\[Pi]"}], 
      RowBox[{"Nmodes", "+", "1"}]], "]"}], " ", 
    RowBox[{"Sin", "[", 
     FractionBox[
      RowBox[{"j", " ", "m", " ", "\[Pi]"}], 
      RowBox[{"Nmodes", "+", "1"}]], "]"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]", "[", "m_", "]"}], ":=", " ", 
    RowBox[{"2", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Delta]", " ", "\[Sigma]"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      FractionBox[
       RowBox[{"m", " ", "\[Pi]"}], 
       RowBox[{"Nmodes", "+", "1"}]], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Delta]", "=", 
     RowBox[{"\[Chi]", "-", "g"}]}], ",", 
    RowBox[{"\[Sigma]", "=", 
     RowBox[{"\[Chi]", "+", "g"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"first", " ", "diagonal", " ", "element"}], ",", " ", 
    RowBox[{
    "lowest", " ", "power", " ", "of", " ", "N", " ", "has", " ", "the", " ", 
     "largest", " ", "coefficient"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]", "=", "1"}], ";", 
  RowBox[{"\[Sigma]", "=", "2"}], ";", 
  RowBox[{"t", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{
        RowBox[{"i", "=", "5"}], ",", "j", ",", "m", ",", "k"}], "]"}], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"t", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", "[", "m", "]"}], "+", 
          RowBox[{"\[Lambda]", "[", "k", "]"}]}], ")"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", "Nmodes"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "Nmodes"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "1", ",", "Nmodes"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.978706696298336*^9, 3.978706712510435*^9}, 
   3.9787095014127693`*^9},
