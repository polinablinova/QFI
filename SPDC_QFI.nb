             RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", "G", ".",
              "\[CapitalSigma]in", ".", "G"}]}], "/.", 
           RowBox[{"\[Phi]", "->", "0"}]}], "]"}]}], "-", "Nmodes"}], "//", 
