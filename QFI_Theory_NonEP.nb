Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Tridiagonal", " ", "Toeplitz", " ", "Decomposition"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Nmodes", "=", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{"BosonicKitaevChain", "[", 
      RowBox[{"Nmodes", ",", "g", ",", 
       RowBox[{"\[Phi]b", "=", "0"}], ",", "\[Chi]", ",", 
       RowBox[{"\[Phi]\[Chi]", "=", "0"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "TraditionalForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"DM", " ", "t"}], "]"}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Scovar", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", 
       RowBox[{"Transpose", "[", 
        RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
