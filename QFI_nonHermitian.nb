Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"steady", " ", "state"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "\[Kappa]", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BQH", "[", 
        RowBox[{"Nmodes", ",", 
         RowBox[{"{", "}"}]}], "]"}], "-", 
       RowBox[{
        FractionBox["\[Kappa]", "2"], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
      RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]in", "=", 
    RowBox[{"LyapunovSolve", "[", 
     RowBox[{
      RowBox[{"DM", " ", "t"}], ",", 
      RowBox[{"Transpose", "[", 
       RowBox[{"DM", " ", "t"}], "]"}], ",", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "\[Kappa]"}], "2"], " ", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]out", "=", 
    RowBox[{
     RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
      RowBox[{"Transpose", "[", "Sphase", "]"}]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"\[Mu]sq", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"F", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      FractionBox[
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}], 
       RowBox[{"1", "+", "\[Mu]sq"}]]}], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"F", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "->", "1"}], ",", 
        RowBox[{
         SubscriptBox["\[Xi]", "1"], "->", "2"}], ",", 
        RowBox[{"\[Kappa]", "->", ".001"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "1000"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
