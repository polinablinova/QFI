Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"steady", "-", 
    RowBox[{"state", " ", "analytical"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Xi]1", ",", "\[Omega]1", ",", "\[Kappa]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Xi]", "1"], ",", 
        SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
       "Reals"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"BQH", "[", 
         RowBox[{"Nmodes", ",", 
          RowBox[{"{", "}"}]}], "]"}], "-", 
        RowBox[{
         FractionBox["\[Kappa]", "2"], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
       RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Xi]", "1"], "->", "\[Xi]1"}], ",", 
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "->", "\[Omega]1"}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\"\<EOM is\>\"", "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "MatrixForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM eigenvalues are\>\"",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "Eigenvalues"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Stability threshold is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Kappa]", "2"]}], "+", 
        SqrtBox[
         RowBox[{
          SubsuperscriptBox["\[Xi]", "1", "2"], "-", 
          SubsuperscriptBox["\[Omega]", "1", "2"]}]]}], "==", "0"}], ",", 
      "\[Kappa]"}], "]"}], "//", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Xi]", "1"], ",", 
           SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
          "Reals"}], ",", "#"}], "]"}], "]"}], "&"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\"\<SS covariance matrix\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"LyapunovSolve", "[", 
       RowBox[{"DM", " ", ",", 
        RowBox[{"Transpose", "[", "DM", "]"}], ",", 
        RowBox[{
         RowBox[{"-", "\[Kappa]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "//", "FullSimplify"}], "//", "MatrixForm"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Mean photon number is\>\"", "\[IndentingNewLine]", 
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", " ", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<Purity\>\"", "\[IndentingNewLine]", 
   RowBox[{"\[Mu]sq", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}]], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<QFI is\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fw", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " "}]], " ", 
      FractionBox[
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", "\[Omega]1"}], "]"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", "\[Omega]1"}], "]"}]}], "]"}], 
       RowBox[{"1", "+", "\[Mu]sq"}]]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<QFI per photon\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fwn", "=", 
    RowBox[{
     FractionBox["Fw", "n"], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<QFI per at EP\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fwn", "=", 
    RowBox[{
     RowBox[{
