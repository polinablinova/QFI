                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}]}], 
                    " ", "t"}], "]"}], ".", "y"}]}], ",", 
                 RowBox[{"-", 
                  RowBox[{"x", ".", 
                   RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}], " ",
                     "t"}], "]"}], ".", "y", ".", 
                   RowBox[{"Transpose", "[", "y", "]"}], ".", 
                   RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}], " ",
                     "t"}], "]"}], ".", 
                   RowBox[{"Transpose", "[", "x", "]"}], ".", "x", ".", 
                   RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}], "t"}], 
                    "]"}], ".", "y", ".", 
                   RowBox[{"Transpose", "[", "y", "]"}], ".", 
                   RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}], "t"}], 
                    "]"}], ".", 
                   RowBox[{"Transpose", "[", "x", "]"}]}]}]}], "}"}]}], 
              "]"}]}], "]"}]}], "]"}], "//", "N"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"nout", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "4"], 
           RowBox[{"Tr", "[", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["2", 
                RowBox[{"Nmodes", "+", "1"}]], ")"}], "2"], 
             RowBox[{"ArrayFlatten", "[", 
              RowBox[{"ReleaseHold", "@", 
               RowBox[{"DiagonalMatrix", "[", 
                RowBox[{"Hold", "/@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", ".", 
                    RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", "]"}]}], 
                    "t"}], "]"}], ".", "y", ".", 
                    RowBox[{"Transpose", "[", "y", "]"}], ".", 
                    RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}]}], 
                    " ", "t"}], "]"}], ".", 
                    RowBox[{"Transpose", "[", "x", "]"}]}], ",", 
                   RowBox[{"x", ".", 
                    RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "\[Lambda]", " ", "]"}], " ",
                     "t"}], "]"}], ".", "y", ".", 
                    RowBox[{"Transpose", "[", "y", "]"}], ".", 
                    RowBox[{"MatrixExp", "[", 
