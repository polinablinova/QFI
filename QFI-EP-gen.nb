Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"g", ",", "\[Chi]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Nmodes", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{"BosonicKitaevChain", "[", 
    RowBox[{"Nmodes", ",", "g", ",", 
     RowBox[{"\[Phi]b", "=", "0"}], ",", "\[Chi]", ",", 
     RowBox[{"\[Phi]\[Chi]", "=", "0"}], ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DM", "=", 
   RowBox[{
    RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
    RowBox[{"(", "EOM", ")"}], ".", 
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigs", "=", 
   RowBox[{"Eigensystem", "[", "DM", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"eigs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"eigs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "]"}], " ", "t"}], "]"}], ".", 
    RowBox[{"Inverse", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"eigs", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TrS", "=", 
   RowBox[{
    RowBox[{"Inverse", "[", 
     RowBox[{"eigs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"eigs", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "]"}], " ", "t"}], "]"}], ".", 
    RowBox[{"eigs", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InS", "=", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"eigs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "]"}]}], " ", "t"}], "]"}], ".", 
    RowBox[{"Inverse", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"eigs", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"InTrS", "=", 
   RowBox[{
    RowBox[{"Inverse", "[", 
     RowBox[{"eigs", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}], ".", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"eigs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "]"}]}], " ", "t"}], "]"}], ".", 
    RowBox[{"eigs", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]in", "=", 
   RowBox[{
    RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "S", ".", "TrS", ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"In\[CapitalSigma]in", "=", 
   RowBox[{
    RowBox[{"CovarBasis", "[", "Nmodes", "]"}], ".", "InTrS", ".", "InS", ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"CovarBasis", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"ArrayFlatten", "@", 
    RowBox[{"ReleaseHold", "@", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Hold", "/@", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", "Nmodes"}], 
        "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Fcov", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
