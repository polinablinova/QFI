Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"BQH", "[", 
      RowBox[{"Nmodes", ",", 
       RowBox[{"{", "}"}]}], "]"}], "-", 
     RowBox[{
      FractionBox["\[Kappa]", "2"], " ", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
    RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DM", "=", 
    RowBox[{
     RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
     RowBox[{"(", "EOM", ")"}], ".", 
     RowBox[{"ConjugateTranspose", "[", 
      RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]", "=", "0.001"}], ";", 
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=", "2"}], ";", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "\[CapitalSigma]in", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[CapitalSigma]in", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"DM", " ", "t"}], ")"}], ".", 
          RowBox[{"\[CapitalSigma]in", "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"\[CapitalSigma]in", "[", "t", "]"}], ".", 
          RowBox[{"Transpose", "[", 
           RowBox[{"DM", " ", "t"}], "]"}]}], "+", 
         RowBox[{"\[Kappa]", " ", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{"\[CapitalSigma]in", "[", "0", "]"}], "==", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "}"}], ",", 
     "\[CapitalSigma]in", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
     RowBox[{"AccuracyGoal", "->", "20"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"ArrayFlatten", "@", 
    RowBox[{"ReleaseHold", "@", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Hold", "/@", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", "Nmodes"}], 
        "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sphase", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]out", "=", 
   RowBox[{"Sphase", ".", 
    RowBox[{"sol", "[", "t", "]"}], ".", 
    RowBox[{"Transpose", "[", "Sphase", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]sq", "=", 
   FractionBox["1", 
    RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "=", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     FractionBox[
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}], 
      RowBox[{"1", "+", "\[Mu]sq"}]]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plt1", "=", 
