     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"\[Kappa]", "  ", 
        RowBox[{
         RowBox[{"MatrixExp", "[", 
          RowBox[{"DM", " ", 
           RowBox[{"(", 
            RowBox[{"t", "-", "s"}], ")"}]}], "]"}], ".", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "DM", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"t", "-", "s"}], ")"}]}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "t"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"DM", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"S", ".", 
       RowBox[{"Transpose", "[", "S", "]"}]}], "+", "int"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"ArrayFlatten", "@", 
      RowBox[{"ReleaseHold", "@", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Hold", "/@", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
           "Nmodes"}], "]"}]}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sphase", "=", 
     RowBox[{"MatrixExp", "[", 
      RowBox[{"\[Phi]", " ", "G"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]out", "=", 
     RowBox[{"Sphase", ".", "\[CapitalSigma]in", ".", 
      RowBox[{"Transpose", "[", "Sphase", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]sq", "=", 
     FractionBox["1", 
      RowBox[{"Det", "[", "\[CapitalSigma]out", "]"}]]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      FractionBox[
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]out", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]out", ",", "\[Phi]"}], "]"}]}], "]"}], 
       RowBox[{"1", "+", "\[Mu]sq"}]]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"plt1", "=", 
    RowBox[{"LogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{"Evaluate", "[", 
          RowBox[{"F", "/.", 
           RowBox[{"\[Phi]", "->", "0"}]}], "]"}], "n"], ",", 
        RowBox[{"8", "+", 
         RowBox[{"8", " ", 
          SuperscriptBox["t", "2"], " ", 
          SubsuperscriptBox["\[Xi]", "1", "2"]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9797650042448215`*^9, 3.9797651300031605`*^9}, {
