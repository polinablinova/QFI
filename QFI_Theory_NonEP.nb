Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EOM", "=", 
   RowBox[{"BosonicKitaevChain", "[", 
    RowBox[{"Nmodes", ",", "g", ",", 
     RowBox[{"\[Phi]b", "=", "0"}], ",", "\[Chi]", ",", 
     RowBox[{"\[Phi]\[Chi]", "=", "0"}], ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
  RowBox[{"DM", "=", 
   RowBox[{
    RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
    RowBox[{"(", "EOM", ")"}], ".", 
    RowBox[{"ConjugateTranspose", "[", 
     RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"DM", " ", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "S", "]"}]}], "Input",
