Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"steady", "-", 
    RowBox[{"state", " ", "analytical"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"\[Xi]1", ",", "\[Omega]1", ",", "\[Kappa]"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Xi]", "1"], ",", 
        SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
       "Reals"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Nmodes", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"BQH", "[", 
        RowBox[{"Nmodes", ",", 
         RowBox[{"{", "}"}]}], "]"}], "-", 
       RowBox[{
        FractionBox["\[Kappa]", "2"], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "/.", 
      RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\"\<EOM is\>\"", "\[IndentingNewLine]", 
   RowBox[{"EOM", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
       RowBox[{"(", "EOM", ")"}], ".", 
       RowBox[{"ConjugateTranspose", "[", 
        RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}], "//", "FullSimplify"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "FullSimplify"}], "//", "MatrixForm"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<DM eigenvalues are\>\"",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "//", "Eigenvalues"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Stability threshold is\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Kappa]", "2"]}], "+", 
        SqrtBox[
         RowBox[{
          SubsuperscriptBox["\[Xi]", "1", "2"], "-", 
          SubsuperscriptBox["\[Omega]", "1", "2"]}]]}], "==", "0"}], ",", 
      "\[Kappa]"}], "]"}], "//", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Xi]", "1"], ",", 
           SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
          "Reals"}], ",", "#"}], "]"}], "]"}], "&"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Kappa]", "2"]}], "+", 
        SqrtBox[
         RowBox[{
          SubsuperscriptBox["\[Xi]", "1", "2"], "-", 
          SubsuperscriptBox["\[Omega]", "1", "2"]}]]}], "==", "0"}], ",", 
      SubscriptBox["\[Omega]", "1"]}], "]"}], "//", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Assuming", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["\[Xi]", "1"], ",", 
           SubscriptBox["\[Omega]", "1"], ",", "\[Kappa]"}], "}"}], "\[Element]",
          "Reals"}], ",", "#"}], "]"}], "]"}], "&"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", "\"\<SS covariance matrix\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{"LyapunovSolve", "[", 
       RowBox[{"DM", " ", ",", 
        RowBox[{"Transpose", "[", "DM", "]"}], ",", 
        RowBox[{
         RowBox[{"-", "\[Kappa]"}], " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "]"}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "//", "FullSimplify"}], "//", "MatrixForm"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<At EP\>\"", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalSigma]in", "/.", 
      RowBox[{
       SubscriptBox["\[Xi]", "1"], "->", 
       SubscriptBox["\[Omega]", "1"]}]}], "//", "FullSimplify"}], "//", 
    "MatrixForm"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<Mean photon number is\>\"", "\[IndentingNewLine]", 
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", " ", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<Purity\>\"", "\[IndentingNewLine]", 
   RowBox[{"\[Mu]", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Det", "[", "\[CapitalSigma]in", "]"}], "]"}]], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", "\"\<Derivative of purity\>\"",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"\[Mu]", ",", 
      SubscriptBox["\[Omega]", "1"]}], "]"}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<QFI w is\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fw", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", " "}]], " ", 
       FractionBox["1", 
        RowBox[{"1", "+", 
         SuperscriptBox["\[Mu]", "2"]}]], 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", 
           SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
         RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalSigma]in", ",", 
           SubscriptBox["\[Omega]", "1"]}], "]"}]}], "]"}]}], "+", 
      RowBox[{"2", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"D", "[", 
           RowBox[{"\[Mu]", ",", 
            SubscriptBox["\[Omega]", "1"]}], "]"}], ")"}], "2"], 
        RowBox[{"1", "-", 
         SuperscriptBox["\[Mu]", "4"]}]]}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<QFI w per photon\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fwn", "=", 
    RowBox[{
     FractionBox["Fw", "n"], "//", "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fwn", "/.", 
     RowBox[{
      SubscriptBox["\[Xi]", "1"], "->", 
      SubscriptBox["\[Omega]", "1"]}]}], "//", "FullSimplify"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
