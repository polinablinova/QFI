Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Sigma]11", "[", "t", "]"}], ",", 
        RowBox[{"\[Sigma]12", "[", "t", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Sigma]21", "[", "t", "]"}], ",", 
        RowBox[{"\[Sigma]22", "[", "t", "]"}]}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqs", "=", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Sigma]", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{
       RowBox[{"DM", ".", 
        RowBox[{"\[Sigma]", "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{"\[Sigma]", "[", "t", "]"}], ".", 
        RowBox[{"Transpose", "[", "DM", "]"}]}], "+", 
       RowBox[{
        FractionBox["\[Kappa]", "2"], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"conds", "=", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", "0", "]"}], "==", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["\[Omega]", "1"], "=", "1"}], ";", 
  RowBox[{
   SubscriptBox["\[Xi]", "1"], "=", "0.1"}], ";", 
  RowBox[{"\[Kappa]", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eqs", ",", "conds"}], "}"}], ",", 
     RowBox[{"\[Sigma]", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0.1", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"\[Sigma]loss", "=", 
  RowBox[{"sol", "[", "1", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"covariance", " ", "at", " ", "time", " ", "tstar"}], 
   "*)"}]}]}], "Input",
