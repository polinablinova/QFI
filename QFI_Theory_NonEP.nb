Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Cos", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "i", "+", "j", "-", "Nmodes", "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"i", "+", "j"}], ")"}], " ", "Nmodes"}]}], ")"}], " ", 
         "\[Pi]"}], 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "Nmodes"}], ")"}]}]], "]"}]}], " ", 
     RowBox[{"Csc", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "+", "j"}], ")"}], " ", "\[Pi]"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "Nmodes"}], ")"}]}]], "]"}]}], "+", 
    RowBox[{
     RowBox[{"Csc", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "j"}], ")"}], " ", "\[Pi]"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "Nmodes"}], ")"}]}]], "]"}], " ", 
     RowBox[{"Sin", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "j"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "Nmodes"}]}], ")"}], " ", "\[Pi]"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "Nmodes"}], ")"}]}]], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9786980485853157`*^9, 3.978698066778036*^9}},
