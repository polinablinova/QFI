      RowBox[{"Scovar", ".", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"2", " ", "Nmodes"}], "]"}], ".", 
       RowBox[{"Transpose", "[", "Scovar", "]"}]}], "//", "FullSimplify"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T1", "=", 
     RowBox[{
      RowBox[{"DM", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"1", ";;", "Nmodes"}], ",", 
         RowBox[{"1", ";;", "Nmodes"}]}], "]"}], "]"}], "//", 
