     RowBox[{"F1", ",", "Fd1", ",", "n1"}], "}"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"QFIperPhotonBQH", "[", 
       RowBox[{"Nmodes", ",", "EOM"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x1", "->", "0"}], ",", 
        RowBox[{"p1", "->", "0"}], ",", 
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "->", "0"}]}], "}"}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{
    FractionBox["F1", "n1"], "//", "FullSimplify"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
