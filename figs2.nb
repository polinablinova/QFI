Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Xi]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EOM", "=", 
     RowBox[{
      RowBox[{"BQH", "[", 
       RowBox[{"Nmodes", ",", 
        RowBox[{"{", "}"}]}], "]"}], "/.", 
      RowBox[{"ZeroPhase", "[", "Nmodes", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DM", "=", 
     RowBox[{
      RowBox[{"QT", "[", "Nmodes", "]"}], ".", 
      RowBox[{"(", "EOM", ")"}], ".", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"QT", "[", "Nmodes", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ".", "DM"}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalSigma]in", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{"DM", " ", "t"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "DM", "]"}], " ", "t"}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"\[CapitalSigma]in", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\"\<photons nonEP\>\"", "\[IndentingNewLine]", 
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "\[CapitalSigma]in", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\"\<QFI nonEP\>\"", "\[IndentingNewLine]", 
   RowBox[{"Fw", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
        RowBox[{"Inverse", "[", "\[CapitalSigma]in", "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{"\[CapitalSigma]in", ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}]}], "]"}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", "\"\<QFI per photon nonEP\>\"",
    "\[IndentingNewLine]", 
   RowBox[{
    FractionBox["Fw", "n"], "//", "FullSimplify"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"DMep", "=", 
    RowBox[{"DM", "/.", 
     RowBox[{
      SubscriptBox["\[Xi]", "1"], "->", 
      SubscriptBox["\[Omega]", "1"]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"SEP", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{"DMep", " ", "t"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}], "//", 
      "FullSimplify"}], "//", "Expand"}]}], 
   "\[IndentingNewLine]", "\"\<QFI EP\>\"", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"der", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"DM", ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DMep", " ", "t"}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}]}], "+", 
      RowBox[{"t", " ", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{"DMep", " ", "t"}], "]"}], ".", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DM", "]"}], ",", 
          SubscriptBox["\[Omega]", "1"]}], "]"}], ".", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", "DMep", "]"}], " ", "t"}], "]"}]}]}]}], "//",
      "FullSimplify"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der", ".", 
     RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der"}], "//", 
    "FullSimplify"}], "\[IndentingNewLine]", 
   RowBox[{"Fwep", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der", ".", 
        RowBox[{"Inverse", "[", "SEP", "]"}], ".", "der"}], "]"}]}], "//", 
     "FullSimplify"}]}], "\[IndentingNewLine]", 
   RowBox[{"nep", "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tr", "[", "SEP", "]"}], "-", 
        RowBox[{"2", " ", "Nmodes"}]}], ")"}]}], "//", "FullSimplify", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "\[IndentingNewLine]"}]}]}]}]], "Input",
