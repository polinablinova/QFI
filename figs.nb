Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "ad", ",", "x", ",", "p"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"a", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "+", 
     RowBox[{"I", " ", "p"}]}], ")"}], "/", 
   RowBox[{"Sqrt", "[", "2", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ad", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", 
     RowBox[{"I", " ", "p"}]}], ")"}], "/", 
   RowBox[{"Sqrt", "[", "2", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   FractionBox[
